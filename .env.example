# 复制为仓库根目录 .env，编辑后直接运行 scripts/*.sh；不需要手动 source。
# 优先级：命令行参数 > 已导出的环境变量 > .env > 默认值。
# 这是本机可信 Bash 配置；路径含空格时加引号，使用绝对路径。
SPECAGENT_WORK_ROOT=/data/your-user/specagent

# Conda 安装与两个环境默认路径。通常只修改 WORK_ROOT 即可。
# CONDA_BASE=/data/your-user/specagent/miniconda3
# CLIENT_PYTHON=/data/your-user/specagent/miniconda3/envs/spectool/bin/python
# SERVER_PYTHON=/data/your-user/specagent/miniconda3/envs/vllm0251/bin/python
# 若自定义 Python 路径，安装与启动均使用它所在的 Conda 前缀；以 /bin/python 结尾。

# 下载位置。复用已有资源时，取消对应行注释并填写真实目录。
# RESOURCE_DIR=/data/your-user/specagent/resources
# LMUData=/data/your-user/specagent/resources/LMUData
# MAIN_MODEL_PATH=/data/your-user/specagent/resources/Qwen/Qwen3.5-27B
# DRAFT_MODEL_PATH=/data/your-user/specagent/resources/Qwen/Qwen3.5-9B

# 下载仓库 ID，必须与准备使用的权重对应；PATH 决定实际保存/读取目录。
MAIN_MODEL_ID=Qwen/Qwen3.5-27B
DRAFT_MODEL_ID=Qwen/Qwen3.5-9B
# 使用 Qwen3.8-27B-FP8 时，将 MAIN_MODEL_ID 改为 Qwen/Qwen3.8-27B-FP8，
# 同时将 MAIN_MODEL_PATH 指向现有目录（或留空，由 RESOURCE_DIR + ID 推导）。

# 默认示例：两张 80GB 卡，每个模型独占一张。根据实际显存调整。
# 24GB 卡示例：MAIN_GPUS=0,1,2,3 / MAIN_TP=4；DRAFT_GPUS=4 / DRAFT_TP=1。
# Main / Draft 使用不同 GPU，TP 必须等于各组卡数。
MAIN_GPUS=0
MAIN_TP=1
DRAFT_GPUS=1
DRAFT_TP=1
MAIN_GPU_MEMORY_UTILIZATION=0.90
DRAFT_GPU_MEMORY_UTILIZATION=0.90
# 显式设置两侧上下文，避免不同 benchmark 的高级入口默认值影响小测。
MAIN_MAX_MODEL_LEN=32768
DRAFT_MAX_MODEL_LEN=32768
MAIN_MAX_NUM_BATCHED_TOKENS=8192
DRAFT_MAX_NUM_BATCHED_TOKENS=8192
MAIN_PORT=8126
DRAFT_PORT=8129
SANDBOX_PORT=18901
SANDBOX_REDIS_PORT=26379
# SANDBOX_REDIS_PASSWORD=your-locally-generated-password

# 网络配置（按需取消注释）。
# HF_ENDPOINT=https://hf-mirror.com
# PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
# MINICONDA_URL=https://mirrors.tuna.tsinghua.edu.cn/anaconda/miniconda/Miniconda3-py312_26.9.4-1-Linux-x86_64.sh

# vLLM 官方 wheel 的本地缓存路径或镜像 URL（仍校验固定 SHA256）。
# VLLM_WHEEL=/data/your-user/cache/vllm-0.25.1+cu129-cp38-abi3-manylinux_2_28_x86_64.whl
# VLLM_WHEEL_URL=https://your-trusted-mirror/path/to/the-same-wheel.whl
