# Copy to .env, edit, then: set -a; source .env; set +a
# Use an absolute path on a data disk. No root/admin account is required.
SPECAGENT_WORK_ROOT=/data/your-user/specagent

# Example for 4 x 24GB Main + 1 x 24GB Draft. Adjust to actual VRAM/topology.
# For GPUs with sufficient memory, Main may use fewer GPUs with matching TP.
MAIN_GPUS=0,1,2,3
MAIN_TP=4
DRAFT_GPUS=4
DRAFT_TP=1
DRAFT_GPU_MEMORY_UTILIZATION=0.90
MODEL_MAX_LEN=32768
MAIN_MAX_NUM_BATCHED_TOKENS=8192
DRAFT_MAX_NUM_BATCHED_TOKENS=8192

# Optional overrides. The defaults derive from SPECAGENT_WORK_ROOT.
# RESOURCE_DIR=/data/your-user/specagent/resources
# CONDA_BASE=/data/your-user/specagent/miniconda3
# LMUData=/data/your-user/specagent/resources/LMUData
# HF_ENDPOINT=https://hf-mirror.com
# PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
# MINICONDA_URL=https://mirrors.tuna.tsinghua.edu.cn/anaconda/miniconda/Miniconda3-py312_26.9.4-1-Linux-x86_64.sh
# MAIN_MODEL_PATH=/absolute/path/to/Qwen3.5-27B
# DRAFT_MODEL_PATH=/absolute/path/to/Qwen3.5-9B
# SANDBOX_REDIS_PASSWORD=your-locally-generated-password
